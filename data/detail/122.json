ooks.rakuten.co.jp/rb/18596353/"}}},"122462":{"rkt":{"au":["みかみ てれん","竹嶋 えく"],"pub":"集英社","latest":{"volume":8,"date":"2025-09-25","price":814,"url":"https://books.rakuten.co.jp/rb/18341458/"}},"bgm":{"sum":"「我再也不要孤零零的了！我要贏得最棒的高中生活！」\n\n捨棄孤零零的中學時代，在高中初次亮相的我——甘織玲奈子。\n但我本性陰暗，沒辦法習慣我所憧憬的陽光生活，要窒息了！就在這時，因為一些意外我與我們學校的超級巨星·王塚真唯成為了共享彼此煩惱的密友。\n\n只要有真唯在，我每天都能努力——本應如此！\n\n「我……愛上你了」\n\n「等等！說好的做朋友呢」\n\n戀人什麼的是不穩定的關係，不行！我想交到最棒的朋友享受高中生活！\n\n但真唯似乎也不能完全放下戀心——。\n\n「一決勝負吧，看看符合我們的關係到底是戀人還是摯友」\n\n如此這般，賭上兩人關係的馬不停蹄的愛情喜劇，開幕！\n\n個人出版レーベル『みかみてれん文庫』でKindleライトノベルランキング上位を席巻した、みかみてれん先生の完全新作ガールズラブコメが遂に登場!\n\nタイトルは──、『わたしが戀人になれるわけないじゃん、ムリムリ!(※ムリじゃなかった!?)』(略稱:わたなれ)\n\nイラストをご擔當されるのは、漫畫やアニメのキャラクター原案で大活躍中の竹嶋えく先生!\n最強タッグでお屆けする、最高のノンストップ・ガールズラブコメディに、ご期待ください!!\n\n「…","tags":["百合","輕小說","みかみてれん","後宮","竹嶋えく","戀愛","歡樂","小說","屑粉毛","日本","校園","日常"],"au":"みかみてれん","il":"竹嶋えく","pub":"集英社","label":"ダッシュエックス文庫","date":"2020-02-21","alias":["わたなれ（WataNare）","There's No Freaking Way I'll be Your Lover! Unless...","我怎么可能成为你的恋人，办不到办不到！(※真香!?)","我怎么可能成为你的恋人，不行不行！(※不是不可能！？)"]}},"122493":{"rkt":{"au":["悪一"],"pub":"アース・スターエンターテイメント"}},"122599":{"rkt":{"au":["亜逸","ゆらん"],"pub":"KADOKAWA","latest":{"volume":3,"date":"2016-10-20","price":726,"url":"https://books.rakuten.co.jp/rb/14428583/"}}},"122608":{"rkt":{"au":["渡瀬 草一郎","ぎん太","川原 礫"],"pub":"KADOKAWA","latest":{"volume":3,"date":"2018-08-10","price":693,"url":"https://books.rakuten.co.jp/rb/15555468/"}}},"122614":{"rkt":{"au":["いぬぶくろ","ニリツ"],"pub":"KADOKAWA","latest":{"volume":2,"date":"2016-10-28","price":737,"url":"https://books.rakuten.co.jp/rb/14473380/"}}},"122627":{"rkt":{"au":["桜目 禅斗","かるたも"],"pub":"KADOKAWA","latest":{"volume":2,"date":"2020-09-30","price":748,"url":"https://books.rakuten.co.jp/rb/16444945/"}}},"122662":{"rkt":{"au":["絢乃","乾和音(artumph)"],"pub":"一二三書房","latest":{"volume":6,"date":"2024-10-25","price":836,"url":"https://books.rakuten.co.jp/rb/17983279/"},"first":"2020-03-28"}},"122677":{"rkt":{"au":["緑黄色野菜"],"pub":"TOブックス","latest":{"volume":3,"date":"2020-08-11","price":1399,"url":"https://books.rakuten.co.jp/rb/16364300/"}}},"122680":{"bgm":{"sum":"無數偉大魔術師輩出的名門，阿諾德魔術學院。 少年雷伊·懷特，\n作為學院有史以來唯一一個一般家庭出身的魔術師，將要在這裡入學。\n周圍全都是貴族以及出身於魔術師家世的學生們，\n身處其中的他被人投以嚴苛的視線。但是人們並不知道。\n他正是，即使在曾經的極東戰役中也取得了眾多戰果的存在，以及現在，\n被世人謳歌為世界七大魔術師之中也是最強的「冰劍的魔術師」的這件事—。\n被輕視為枯萎的魔術師的同時，不久他就向周圍的人展示了那份力量……！？\n這是，冰封許久的規格外的天才將堅冰融化的物語——。","tags":["輕小說"],"au":"御子柴奈々","il":"梱枝りこ","pub":"講談社","label":"ラノベ文庫","mag":"小説家になろう、カクヨム","date":"2020-07-02","alias":["冰劍的魔術師將要統一世界〜身為世界最強魔術師的少年，去魔術學院上學了"]}},"122711":{"bgm":{"sum":"異世界に勇者として召喚された大學生の柏木裕哉は、剣と魔法で魔王を倒し、裡ボスの邪神も倒すという某有名RPG通りのエンディングを迎えて現代日本に帰還した。召喚された元の場所・元の時間に帰ってきたものの、500円玉を握りつぶせたり、魔法を使えたりと、異世界での勇者そのままのステータスを持っていて―。「小説家になろう」発、めでたしめでたしの後を描いたファンタジー!","au":"月夜乃古狸","il":"吉沢メガネ","pub":"双葉社","mag":"小説家になろう","date":"2018-01-31"}},"122737":{"rkt":{"au":["ハヤケン","Nagu"],"pub":"ホビージャパン","latest":{"volume":13,"date":"2025-10-01","price":748,"url":"https://books.rakuten.co.jp/rb/18345578/"}}},"122745":{"rkt":{"au":["真代屋 秀晃","nauribon"],"pub":"KADOKAWA","latest":{"volume":3,"date":"2017-07-07","price":693,"url":"https://books.rakuten.co.jp/rb/14980222/"}}},"122773":{"rkt":{"au":["ぷにちゃん","藻"],"pub":"KADOKAWA","latest":{"volume":2,"date":"2020-04-10","price":1320,"url":"https://books.rakuten.co.jp/rb/16250789/"}}},"122774":{"rkt":{"au":["富樫聖夜","カスカベ アキラ"],"pub":"KADOKAWA","latest":{"volume":2,"date":"2017-12-15","price":682,"url":"https://books.rakuten.co.jp/rb/15211108/"}}},"122776":{"rkt":{"au":["江本 マシメサ","雲屋 ゆきお"],"pub":"KADOKAWA","latest":{"volume":3,"date":"2018-09-15","price":726,"url":"https://books.rakuten.co.jp/rb/15571882/"}}},"122780":{"rkt":{"au":["保志 あかり","大木戸 いずみ","早瀬ジュン"],"pub":"KADOKAWA"},"bgm":{"sum":"綺麗事だらけの世界なんて絶対イヤ。ちょっとズレた令嬢の異世界悪役転生記\n\n正統派ヒロインにありがちな“いい子ちゃん発言”。\nそれが大ッ嫌いな私が、念願かなって悪役令嬢に転生!!\n誰にも文句を言わせない悪女になるためには、體を鍛えて猛勉強し、魔法の腕も磨かないとね!\n――と頑張っただけなのに、悪役になろうとすればするほど周囲の好感度が上がるようで!?\nいいわ、悪女としてその期待、全力で裡切ってみせます!","tags":["輕小說"],"au":"大木戸いずみ","il":"早瀬ジュン","pub":"KADOKAWA","label":"ビーズログ文庫","mag":"小説家になろう","date":"201