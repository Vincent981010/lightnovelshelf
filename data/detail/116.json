":{"volume":3,"date":"2018-03-15","price":1320,"url":"https://books.rakuten.co.jp/rb/15333071/"}}},"116692":{"rkt":{"au":["赤城 大空","魔太郎"],"pub":"小学館","latest":{"volume":11,"date":"2024-06-18","price":935,"url":"https://books.rakuten.co.jp/rb/17873054/"}}},"116751":{"rkt":{"au":["紙城 境介","木鈴 カケル"],"pub":"KADOKAWA","latest":{"volume":3,"date":"2022-04-25","price":770,"url":"https://books.rakuten.co.jp/rb/17075061/"}}},"116778":{"bgm":{"sum":"女大學生津場木葵繼承了過世祖父看得見妖怪的力量，某天，突然被抓到座落於妖怪鬼神們所居住的隱世之中的百年老鋪旅館“天神屋”，困惑的葵被告知其祖父欠下了鉅債，以及當時約定好將她嫁入鬼神的大老闆家當作借款的擔保品一事，葵不願從命，為了拒絕這樁婚事，向妖怪宣言要在天神屋工作來還債，沒想到卻引起妖怪們群情激憤……面對暴躁的土蜘蛛、冷冰冰的雪女、不知是敵是友的無臉女、狸貓、天狗，還有忽冷忽熱的大老闆鬼神，葵只能以美味料理與不認輸的骨氣收服他們。與此同時，隨著葵陸續以料理解決難題，隱世居民訪客的登門造訪和來自其他妖怪的覬覦，也讓葵對於人類和妖怪鬼神原有的認知逐步產生改變。","tags":["小說系列","輕小說系列"],"au":"友麻碧","il":"Laruha","pub":"KADOKAWA","date":"2015-04-12"}},"116799":{"rkt":{"au":["鳳ナナ"],"pub":"アルファポリス","latest":{"volume":7,"date":"2025-12-02","price":1540,"url":"https://books.rakuten.co.jp/rb/18451245/"}}},"116807":{"rkt":{"au":["あまうい 白一","天野 英"],"pub":"小学館","latest":{"volume":3,"date":"2020-11-19","price":1320,"url":"https://books.rakuten.co.jp/rb/16477386/"}}},"116811":{"rkt":{"au":["西野 向日葵","今井 喬裕"],"pub":"KADOKAWA","latest":{"volume":2,"date":"2020-09-15","price":748,"url":"https://books.rakuten.co.jp/rb/16409214/"}}},"116839":{"rkt":{"au":["岡沢 六十四","sage・ジョー"],"pub":"講談社","latest":{"volume":3,"date":"2020-03-27","price":1430,"url":"https://books.rakuten.co.jp/rb/16181856/"}}},"116864":{"rkt":{"au":["七野りく","cura"],"pub":"KADOKAWA","latest":{"volume":23,"date":"2026-09-18","price":924,"url":"https://books.rakuten.co.jp/rb/18723013/"}},"bgm":{"sum":"「我還是第一次看到，有人能將浮游魔法使得如此收放自如。」\n「這一點也不難，只是大家都沒嘗試過罷了。」\n擁有當代社會無法衡量的超規格魔法技術，卻保持謙虛態度生活的青年‧亞連，在恩師的委託下，以家庭教師的身份前去指導『用不了魔法』的公爵千金‧蒂娜。面對這名已被無數人放棄的少女，不打算死心的亞連所傳授的課程是──\n「就我個人認為，魔法並不是人類以操控魔力的方式施放，而是向精靈借用力量罷了。」亞連的魔法課程內容顛覆了常識。在諄諄善誘後，亞連解開了封印在蒂娜身上的謎團，而這也是向世界掀起革命的師徒傳說開端！","tags":["輕小說","七野りく","後宮","戀愛","魔法","Cura","奇幻","戰爭","ファンタジア文庫","カクヨム","web小說"],"au":"七野りく","il":"cura","pub":"KADOKAWA","mag":"カクヨム","date":"2018-12-20"}},"116866":{"rkt":{"au":["春日 みかげ","みやま 零","深井 涼介"],"pub":"KADOKAWA","latest":{"volume":3,"date":"2017-02-17","price":682,"url":"https://books.rakuten.co.jp/rb/14628955/"}}},"116988":{"rkt":{"au":["ショーン田中"],"pub":"TOブックス"}}}
